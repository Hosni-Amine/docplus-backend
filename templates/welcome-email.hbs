<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to DocPlus</title>
</head>
<body style="margin:0;padding:0;background-color:#eef2f6;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    Your DocPlus account is ready. Sign in to get started.
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eef2f6;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background-color:#ffffff;border-radius:16px;">
          <tr>
            <td style="padding:32px 32px 8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
              <p style="margin:0;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#0f4c81;">DocPlus</p>
              <h1 style="margin:12px 0 0;font-size:24px;line-height:1.3;font-weight:600;color:#122033;">Welcome to DocPlus</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#243140;">
              {{#if fullname}}
                <p style="margin:16px 0 0;">Hello {{fullname}},</p>
              {{else}}
                <p style="margin:16px 0 0;">Hello,</p>
              {{/if}}
              <p style="margin:12px 0 0;">Your account is ready. Sign in to start using DocPlus.</p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:28px 32px 8px;">
              <a href="{{url}}" style="display:inline-block;padding:14px 28px;background-color:#0f4c81;color:#ffffff;text-decoration:none;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;">Sign in</a>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#5c6b7a;">
              <p style="margin:24px 0 0;padding-top:16px;border-top:1px solid #e6ebf1;">This is an automatic message. Please do not reply.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
