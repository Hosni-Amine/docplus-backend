<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{otpCode}} is your DocPlus verification code</title>
</head>
<body style="margin:0;padding:0;background-color:#eef2f6;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    Your DocPlus verification code is {{otpCode}}. It expires in {{expirationMinutes}} minutes.
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eef2f6;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:480px;background-color:#ffffff;border-radius:16px;">
          <tr>
            <td style="padding:32px 32px 8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
              <p style="margin:0;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#0f4c81;">DocPlus</p>
              <h1 style="margin:12px 0 0;font-size:24px;line-height:1.3;font-weight:600;color:#122033;">Verification code</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#243140;">
              <p style="margin:16px 0 0;">Hello {{fullname}},</p>
              <p style="margin:12px 0 0;">Your DocPlus verification code is {{otpCode}}.</p>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 32px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f7fb;border-radius:12px;">
                <tr>
                  <td align="center" style="padding:24px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
                    <p style="margin:0;font-size:13px;color:#5c6b7a;">Enter this code to sign in</p>
                    <p style="margin:8px 0 0;font-size:36px;line-height:1.2;font-weight:700;letter-spacing:8px;color:#0f4c81;">{{otpCode}}</p>
                    <p style="margin:8px 0 0;font-size:13px;color:#5c6b7a;">This code expires in {{expirationMinutes}} minutes.</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#5c6b7a;">
              <p style="margin:16px 0 0;">If you did not request this code, you can ignore this email.</p>
              <p style="margin:24px 0 0;padding-top:16px;border-top:1px solid #e6ebf1;font-size:12px;">This is an automatic message. Please do not reply.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
