<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if rescheduled}}Your appointment has been rescheduled{{else}}Your appointment is confirmed{{/if}}</title>
</head>

<body style="margin:0;padding:0;background-color:#eef2f6;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
    {{#if rescheduled}}New time{{else}}Appointment{{/if}}: {{startFormatted}}{{#if practitionerName}} with
    {{practitionerName}}{{/if}}{{#if attendeeName}} with {{attendeeName}}{{/if}}.
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
    style="background-color:#eef2f6;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
          style="max-width:480px;background-color:#ffffff;border-radius:16px;">
          <tr>
            <td
              style="padding:32px 32px 8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
              <p
                style="margin:0;font-size:13px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#0f4c81;">
                DocPlus</p>
              <h1 style="margin:12px 0 0;font-size:24px;line-height:1.3;font-weight:600;color:#122033;">{{#if
                rescheduled}}Your appointment has moved{{else}}Your appointment is confirmed{{/if}}</h1>
            </td>
          </tr>
          <tr>
            <td
              style="padding:8px 32px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#243140;">
              <p style="margin:16px 0 0;">Hello {{fullname}},</p>
              <p style="margin:12px 0 0;">
                {{#if rescheduled}}
                  Your appointment{{#if otherPartyName}} with {{otherPartyName}}{{/if}} has been rescheduled to <strong>{{startFormatted}}</strong>{{#if locationPhrase}} {{locationPhrase}}{{/if}}.
                {{else}}
                  You have an appointment{{#if otherPartyName}} with {{otherPartyName}}{{/if}} scheduled for <strong>{{startFormatted}}</strong>{{#if locationPhrase}} {{locationPhrase}}{{/if}}.
                {{/if}}
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:24px 32px 8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                style="background-color:#f3f7fb;border-radius:12px;">
                <tr>
                  <td
                    style="padding:20px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:#243140;">
                    <p style="margin:0;font-weight:600;font-size:17px;color:#122033;">{{title}}</p>
                    <p style="margin:10px 0 0;">{{startFormatted}}</p>
                    {{#if practitionerName}}<p style="margin:4px 0 0;color:#5c6b7a;">With {{practitionerName}}</p>
                    {{/if}}
                    {{#if attendeeName}}<p style="margin:4px 0 0;color:#5c6b7a;">Attendee: {{attendeeName}}</p>{{/if}}
                    {{#if consultationTypeLabel}}<p style="margin:4px 0 0;color:#5c6b7a;">Type:
                      {{consultationTypeLabel}}</p>{{/if}}
                    {{#if address}}<p style="margin:4px 0 0;color:#5c6b7a;">Address: {{address}}</p>{{/if}}
                    {{#if phone}}<p style="margin:4px 0 0;color:#5c6b7a;">Phone: {{phone}}</p>{{/if}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {{#if joinUrl}}
          <tr>
            <td align="center"
              style="padding:24px 32px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
              <a href="{{joinUrl}}"
                style="display:inline-block;padding:14px 28px;border-radius:10px;background-color:#0f4c81;color:#ffffff;font-size:16px;font-weight:600;text-decoration:none;">Join
                the video consultation</a>
              <p style="margin:12px 0 0;font-size:13px;color:#5c6b7a;">The room opens 15 minutes before the start time.
              </p>
              <p style="margin:8px 0 0;font-size:13px;color:#5c6b7a;">This link is personal to you. Please do not
                forward it.</p>
            </td>
          </tr>
          {{/if}}
          <tr>
            <td
              style="padding:8px 32px 32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#5c6b7a;">
              <p style="margin:16px 0 0;">Need to change or cancel? Reply to the practice that booked this appointment.
              </p>
              <p style="margin:24px 0 0;padding-top:16px;border-top:1px solid #e6ebf1;font-size:12px;">This is an
                automatic message. Please do not reply.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>